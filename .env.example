# Base URL of the control plane. Change it only if you run your own instance.
STRATACORE_URL=https://stratacore.dev
# Agent token created in the console. Keep it out of version control.
STRATACORE_AGENT_TOKEN=sc_live_replace_me
# Handlers only log what they would do until this is set to "false".
DRY_RUN=true
# Seconds between polls.
POLL_INTERVAL=15
